# Banco de dados PostgreSQL / Neon
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# JWT - use uma chave longa e aleatória em produção
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# E-mail usado para verificação e recuperação de senha
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua-senha-de-app-do-gmail

# Administrador (não publique estes valores no GitHub)
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=troque-por-uma-senha-administrativa-forte

# URL pública do frontend, sem barra no final
FRONTEND_URL=https://skill-market-redesign.vercel.app
